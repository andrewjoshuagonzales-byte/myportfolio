---
import Layout from '../layouts/Layout.astro';
import '../styles/portfolio.css'; 

const fontAwesomeLink = "https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css";

const profile = {
  name: "Andrew Joshua Gonzales",
  title: "Junior Graphics Designer & Data Analyst",
  avatar: "/profile.jpg", 
  summary: "I blend creativity, technology, and analytical thinking to build meaningful digital solutions. With experience in data analysis, software quality assurance, and graphic design, I enjoy transforming complex ideas into user-friendly experiences, actionable insights, and high-quality products. I'm passionate about continuous learning, innovation, and creating work that makes a measurable impact.",
  contact: {
    phone: "+63 927 615 5874",
    email: "andrewjoshuagonzales@gmail.com",
    location: "Matina Pangi, Davao City",
  }
};

const skills = {
  design: [
    { name: "Adobe Photoshop", short: "Ps", isAdobe: true, color: "#31a8ff", bg: "#001c3d" },
    { name: "Adobe Illustrator", short: "Ai", isAdobe: true, color: "#ff9a00", bg: "#331c00" },
    { name: "Adobe After Effects", short: "Ae", isAdobe: true, color: "#d19eff", bg: "#1f003d" },
    { name: "CorelDRAW", icon: "fa-solid fa-feather-pointed", isAdobe: false, color: "#22c55e", bg: "#ffffff" },
    { name: "Figma", icon: "fa-brands fa-figma", isAdobe: false, color: "#f24e1e", bg: "#ffffff" }
  ],
  development: [
    { name: "HTML & CSS", icon: "fa-brands fa-html5", isAdobe: false, color: "#e34f26", bg: "#ffffff" },
    { name: "JavaScript", icon: "fa-brands fa-js", isAdobe: false, color: "#f7df1e", bg: "#ffffff" },
    { name: "PHP", icon: "fa-brands fa-php", isAdobe: false, color: "#777bb4", bg: "#ffffff" },
    { name: "MySQL / MySQLi", icon: "fa-solid fa-database", isAdobe: false, color: "#00758f", bg: "#ffffff" },
    { name: "Python", icon: "fa-brands fa-python", isAdobe: false, color: "#3776ab", bg: "#ffffff" },
    { name: "Visual Studio Code", icon: "fa-solid fa-code", isAdobe: false, color: "#007acc", bg: "#ffffff" }
  ]
};

const experienceHighlights = [
  {
    id: "exp-qa",
    role: "Data Analyst / QA Tester",
    company: "Southern Philippines Medical Center",
    period: "",
    icon: "fa-solid fa-chart-pie",
    bullets: [
      "Perform data analysis and reporting to support decision making.",
      "Conduct software testing to ensure system quality and performance.",
      "Identify bugs and collaborate with developers for resolution.",
      "Created Business Requirement (BRD) & Functional Requirement Documents (FRD)."
    ]
  },
  {
    id: "exp-design",
    role: "Graphics Designer",
    company: "DecoArts",
    period: "",
    icon: "fa-solid fa-palette",
    bullets: [
      "Designed posters, logos, and high-impact social media content.",
      "Created visual materials closely aligned with strict brand identity guidelines.",
      "Produced custom vector illustrations and print layout structures.",
      "Assisted with basic motion graphics, animations, and creative assets."
    ]
  },
  {
    id: "exp-dev",
    role: "Junior Web Developer",
    company: "Altria Call Center Davao",
    period: "",
    icon: "fa-solid fa-laptop-code",
    bullets: [
      "Assisted in front-end development using HTML, CSS, and JavaScript framework modules.",
      "Supported core website updates, hotfixes, and structural maintenance profiles.",
      "Collaborated effectively with internal teams on agile web environment projects."
    ]
  }
];

const futureProjects = [
  { 
    id: "proj-1",
    title: "Social Media Postings",  
    category: "Graphic Design", 
    desc: "A complete collection of promotional food graphics, product showcases, and social media layout designs.",
    image: "/1.jpg", 
    collection: ["/1.jpg","/2.jpg","/3.jpg","/5.jpg","/6.jpg"] 
  },
  { 
    id: "proj-2",
    title: "Web UI Design & Development", 
    category: "Web Development", 
    desc: "Interactive front-end modules and layout structures built with clean, modern styling mechanics.",
    image: "/3.jpg", 
    collection: ["/1.jpg","/2.jpg","/3.jpg","/5.jpg"] 
  },
  { 
    id: "proj-3",
    title: "Brand Identity Assets", 
    category: "Branding / Logo", 
    desc: "Vector identity assets, clean layout patterns, and high-fidelity project typography showcases.",
    image: "/5.jpg", 
    collection: ["/1.jpg","/2.jpg","/3.jpg","/5.jpg"] 
  },
];
---

<Layout title={`${profile.name} - Portfolio`}>
  <link rel="stylesheet" href={fontAwesomeLink} />
  
  <main class="portfolio-container">
    
    <header class="hero">
      <div class="hero-layout">
        <div class="hero-avatar-container">
          <img src={profile.avatar} alt={profile.name} class="hero-avatar" />
          <div class="avatar-glow-ring"></div>
        </div>

        <div class="hero-content">
          <div class="badge-row">
            <span class="badge">🔥 Available for Projects</span>
            <span class="badge-secondary-tag">My Space</span>
          </div>
          <h1>{profile.name}</h1>
          <p class="tagline">{profile.title}</p>
          <div class="bio-container">
            <p class="bio">{profile.summary}</p>
          </div>
          <div class="cta-group">
            <button id="open-contact-modal" class="btn btn-primary">
              <i class="fa-solid fa-paper-plane"></i> Let's Work Together
            </button>
            <a href="#work" class="btn btn-secondary">
              <i class="fa-solid fa-folder-open"></i> Explore Projects
            </a>
          </div>
        </div>
      </div>
    </header>

    <section class="master-hub-panel">
      
      <div class="hub-left-deck">
        <div class="hub-contact-column">
          <h3>Contact</h3>
          <div class="hub-contact-list">
            <div class="hub-contact-item">
              <div class="icon-bubble"><i class="fa-solid fa-phone"></i></div>
              <div class="contact-details">
                <span>Phone</span>
                <p>{profile.contact.phone}</p>
              </div>
            </div>
            <div class="hub-contact-item">
              <div class="icon-bubble"><i class="fa-solid fa-envelope"></i></div>
              <div class="contact-details">
                <span>Email</span>
                <p><a href={`mailto:${profile.contact.email}`}>{profile.contact.email}</a></p>
              </div>
            </div>
            <div class="hub-contact-item">
              <div class="icon-bubble"><i class="fa-solid fa-location-dot"></i></div>
              <div class="contact-details">
                <span>Location</span>
                <p>{profile.contact.location}</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="hub-vertical-divider"></div>
      
      <div class="hub-experience-flash-column">
        <h3>Work Highlights</h3>
        <div class="flash-tabs-container">
          <div class="flash-tabs-nav" role="tablist" aria-label="Work roles short track">
            {experienceHighlights.map((exp, idx) => (
              <button 
                class={`flash-nav-btn ${idx === 0 ? 'active' : ''}`}
                data-target={exp.id}
                role="tab"
                aria-selected={idx === 0 ? "true" : "false"}
              >
                <i class={exp.icon}></i>
                <div class="btn-text-meta">
                  <span class="role-title-puck">{exp.role.split('/')[0]}</span>
                  <span class="company-puck">{exp.company}</span>
                </div>
              </button>
            ))}
          </div>

          <div class="flash-tabs-content-pane">
            {experienceHighlights.map((exp, idx) => (
              <div 
                id={exp.id} 
                class={`flash-content-panel ${idx === 0 ? 'active' : ''}`}
                role="tabpanel"
              >
                <div class="panel-header-badge">
                  <h4>{exp.role}</h4>
                  <span class="panel-time-tag">{exp.period}</span>
                </div>
                <ul class="flash-bullet-list">
                  {exp.bullets.map(bullet => (
                    <li><i class="fa-solid fa-circle-chevron-right list-bullet-icon"></i> <span>{bullet}</span></li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="hub-vertical-divider"></div>
      
      <div class="hub-skills-column">
        <h3>Software & Tech Skills</h3>
        <div class="skills-wrapper">
          <div class="skills-category-group">
            <span class="skills-sub-title">Creative Suite</span>
            <div class="skills-app-grid">
              {skills.design.map((skill) => (
                <div class="skill-app-card" title={skill.name}>
                  {skill.isAdobe ? (
                    <div class="adobe-app-logo" style={`background-color: ${skill.bg}; border-color: ${skill.color}; color: ${skill.color};`}>
                      {skill.short}
                    </div>
                  ) : (
                    <div class="standard-app-logo" style={`background-color: ${skill.bg};`}>
                      <i class={skill.icon} style={`color: ${skill.color};`}></i>
                    </div>
                  )}
                  <span class="skill-app-name">{skill.name}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="skills-category-group">
            <span class="skills-sub-title">Development Stack</span>
            <div class="skills-app-grid">
              {skills.development.map((skill) => (
                <div class="skill-app-card" title={skill.name}>
                  <div class="standard-app-logo" style={`background-color: ${skill.bg};`}>
                    <i class={skill.icon} style={`color: ${skill.color};`}></i>
                  </div>
                  <span class="skill-app-name">{skill.name}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="work" class="section-block">
      <div class="section-header-row">
        <div class="header-titles">
          <div class="briefcase-icon-box">
            <i class="fa-solid fa-briefcase"></i>
          </div>
          <h2>My Projects</h2>
        </div>
        <div class="dashed-line-container">
          <div class="dashed-line"></div>
          <div class="dashed-line-dot"></div>
        </div>
        <div class="header-action">
          <a href="#work" class="btn-view-all">
            View All Projects <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>
      </div>
      
      <div class="works-grid">
        {futureProjects.map((project) => (
          <div class="project-card" data-project-id={project.id}>
            <div class="project-img-placeholder">
              {project.image ? (
                <img src={project.image} alt={project.title} class="project-thumbnail" />
              ) : (
                <span class="img-icon">🖼️</span>
              )}
              <div class="project-overlay">
                <span class="view-tag">View Collection →</span>
              </div>
            </div>
            <div class="project-info">
              <span class="project-cat">{project.category}</span>
              <h3>{project.title}</h3>
              <p>{project.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

  </main>

  <dialog id="gallery-modal" class="modal">
    <div class="modal-box">
      <button id="close-modal" class="close-btn" aria-label="Close modal">✕</button>
      <div class="modal-layout-split">
        <div class="modal-visual-side">
          <div class="slider-wrapper">
            <button id="prev-slide" class="slide-nav-btn" type="button">❮</button>
            <div class="slider-display">
              <img id="modal-img" src="" alt="Showcase asset preview representation" />
            </div>
            <button id="next-slide" class="slide-nav-btn" type="button">❯</button>
          </div>
          <div id="modal-thumbnails" class="thumbnails-track"></div>
        </div>
        <div class="modal-info-side">
          <span id="modal-cat" class="project-cat">Category</span>
          <h3 id="modal-title">Project Title</h3>
          <p id="modal-desc" class="modal-description">Description text matches item parameters.</p>
        </div>
      </div>
    </div>
  </dialog>

  <dialog id="contact-modal" class="modal">
    <div class="modal-box contact-modal-box">
      <button id="close-contact-modal" class="close-btn" aria-label="Close contact modal">✕</button>
      
      <div class="contact-modal-header">
        <div class="contact-icon-glow">
          <i class="fa-solid fa-comments"></i>
        </div>
        <h3>Let's Connect!</h3>
        <p>Pick your preferred platform to start a conversation or discuss a collaboration.</p>
      </div>

      <div class="contact-channels-grid">
        <a href={`mailto:${profile.contact.email}`} class="channel-card email-card">
          <div class="channel-icon"><i class="fa-solid fa-envelope"></i></div>
          <div class="channel-info">
            <h4>Email Address</h4>
            <p>{profile.contact.email}</p>
          </div>
          <i class="fa-solid fa-chevron-right channel-arrow"></i>
        </a>

        <a href="https://t.me/your_telegram_username" target="_blank" rel="noopener noreferrer" class="channel-card telegram-card">
          <div class="channel-icon"><i class="fa-brands fa-telegram"></i></div>
          <div class="channel-info">
            <h4>Telegram</h4>
            <p>@ajg1999</p>
          </div>
          <i class="fa-solid fa-chevron-right channel-arrow"></i>
        </a>

        <a href="https://m.me/your_messenger_id" target="_blank" rel="noopener noreferrer" class="channel-card messenger-card">
          <div class="channel-icon"><i class="fa-brands fa-facebook-messenger"></i></div>
          <div class="channel-info">
            <h4>Facebook Messenger</h4>
            <p>Andrew Joshua Gonzales</p>
            <p>https://www.facebook.com/DrewG3213/</p>
          </div>
          <i class="fa-solid fa-chevron-right channel-arrow"></i>
        </a>

        <a href="viber://chat?number=%2B639276155874" class="channel-card viber-card">
          <div class="channel-icon"><i class="fa-brands fa-viber"></i></div>
          <div class="channel-info">
            <h4>Viber</h4>
            <p>+63 927 615 5874</p>
          </div>
          <i class="fa-solid fa-chevron-right channel-arrow"></i>
        </a>
      </div>
    </div>
  </dialog>
</Layout>

<script>
  // -- FLASH EXPERIENCES INTERACTIVE CONTROLLER --
  const tabButtons = document.querySelectorAll('.flash-nav-btn');
  const contentPanels = document.querySelectorAll('.flash-content-panel');

  tabButtons.forEach(button => {
    button.addEventListener('click', () => {
      const targetId = button.getAttribute('data-target');

      tabButtons.forEach(btn => {
        btn.classList.remove('active');
        btn.setAttribute('aria-selected', 'false');
      });
      button.classList.add('active');
      button.setAttribute('aria-selected', 'true');

      contentPanels.forEach(panel => {
        if (panel.id === targetId) {
          panel.classList.add('active');
        } else {
          panel.classList.remove('active');
        }
      });
    });
  });

  // -- CONTACT MODAL CONTROLLER (With explicit casting to remove errors) --
  const contactModal = document.getElementById('contact-modal') as HTMLDialogElement | null;
  const openContactBtn = document.getElementById('open-contact-modal');
  const closeContactBtn = document.getElementById('close-contact-modal');

  if (openContactBtn && contactModal && closeContactBtn) {
    openContactBtn.addEventListener('click', () => {
      contactModal.showModal();
    });

    closeContactBtn.addEventListener('click', () => {
      contactModal.close();
    });

    contactModal.addEventListener('click', (e) => {
      if (e.target === contactModal) contactModal.close();
    });
  }
</script>

<script define:vars={{ futureProjects }}>
  // -- LIGHTBOX GALLERY CONTROLLER (With explicit casting to remove errors) --
  const modal = document.getElementById('gallery-modal');
  const closeModalBtn = document.getElementById('close-modal');
  const projectCards = document.querySelectorAll('.project-card');
  
  const modalTitle = document.getElementById('modal-title');
  const modalCat = document.getElementById('modal-cat');
  const modalDesc = document.getElementById('modal-desc');
  const modalImg = document.getElementById('modal-img');
  const thumbsTrack = document.getElementById('modal-thumbnails');
  
  const prevBtn = document.getElementById('prev-slide');
  const nextBtn = document.getElementById('next-slide');

  let activeCollection = [];
  let currentImgIndex = 0;

  function updateSliderImage(index) {
    currentImgIndex = index;
    if (modalImg) modalImg.src = activeCollection[currentImgIndex];
    
    if (thumbsTrack) {
      const thumbs = thumbsTrack.querySelectorAll('.thumb-pill');
      thumbs.forEach((t, i) => {
        if(i === index) t.classList.add('active-thumb');
        else t.classList.remove('active-thumb');
      });
    }
  }

  projectCards.forEach(card => {
    card.addEventListener('click', () => {
      const id = card.getAttribute('data-project-id');
      const data = futureProjects.find(p => p.id === id);
      
      if (!data) return;

      if (modalTitle) modalTitle.textContent = data.title;
      if (modalCat) modalCat.textContent = data.category;
      if (modalDesc) modalDesc.textContent = data.desc;
      
      activeCollection = data.collection || [data.image];
      if (thumbsTrack) thumbsTrack.innerHTML = '';
     
      activeCollection.forEach((imgSrc, idx) => {
        const thumb = document.createElement('img');
        thumb.src = imgSrc;
        thumb.classList.add('thumb-pill');
        thumb.addEventListener('click', () => updateSliderImage(idx));
        if (thumbsTrack) thumbsTrack.appendChild(thumb);
      });

      updateSliderImage(0);
      if (modal) (modal).showModal();
    });
  });

  if (prevBtn) {
    prevBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      let nextIdx = currentImgIndex - 1;
      if (nextIdx < 0) nextIdx = activeCollection.length - 1;
      updateSliderImage(nextIdx);
    });
  }

  if (nextBtn) {
    nextBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      let nextIdx = currentImgIndex + 1;
      if (nextIdx >= activeCollection.length) nextIdx = 0;
      updateSliderImage(nextIdx);
    });
  }

  if (closeModalBtn) closeModalBtn.addEventListener('click', () => modal && (modal).close());
  if (modal) modal.addEventListener('click', (e) => { if(e.target === modal) (modal).close(); });
</script>